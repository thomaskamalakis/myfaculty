# Copy this file to .env and edit it:   cp env.template .env
# Never commit your .env file.

# Django
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:30100

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# E-mail: with DUMMY_EMAILS=True messages are printed in the log of the
# web/worker containers instead of being sent (no Gmail setup needed).
# Set it to False only after you have created the Gmail tokens (see README).
DUMMY_EMAILS=True
DEAN_EMAIL=dean@example.com
ALWAYS_NOTIFY=
EMAIL_PLATFORM_URL=http://localhost:30100

# CAPTCHA. These are Google's public *test* keys: they always pass and work
# only for local development. For a real deployment get your own reCAPTCHA v2 pair.
RECAPTCHA_PUBLIC_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_PRIVATE_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- Optional integrations (leave empty if you do not use them) ---

# LDAP authentication. If AUTH_LDAP_SERVER_URI is empty only local Django
# accounts are used (log in with a username/password created by you).
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=

# Student information system (SIS) synchronisation
SIS_KEYCLOAK_TOKEN_URL=
SIS_CLIENT_ID=
SIS_USER_NAME=
SIS_PASSWD=

# Budibase synchronisation (legacy import scripts)
BUDI_KEY=
